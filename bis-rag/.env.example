# NVIDIA NIM API Key — get free tier at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Optional: override model names
# NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct

# Set to "local" to force local fallback (no NVIDIA API calls)
# EMBED_BACKEND=nvidia
# LLM_BACKEND=nvidia
